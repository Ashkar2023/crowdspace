{
    "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/nodemon.json",
    "restartable": "rs",
    "ignore": [
        ".git",
        "node_modules/**/node_modules"
    ],
    "verbose": false,
    "exec": "npm run build && node --env-file=.env dist/index.js",
    "execMap": {},
    "watch": [
        "src/"
    ],
    "env": {
        "NODE_ENV": "dev"
    },
    "ext": "ts,json"
}