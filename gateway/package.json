{
    "name": "gateway",
    "version": "1.0.0",
    "main": "dist/index.js",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "nodemon --watch src/ --ext ts,json --ignore .git --ignore node_modules --exec \"npm run build && node --env-file=.env dist/index.js\"",
        "build": "rimraf dist/ && tsc && tsc-alias",
        "devn": "nodemon",
        "dev:debug": "nodemon --watch src/ --ext ts,json --ignore .git --ignore node_modules --exec \"tsc && node inspect --env-file=.env dist/index.js\""
    },
    "dependencies": {
        "@crowdspace/common": "*",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "express": "^4.21.1",
        "http-proxy-middleware": "^3.0.3",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "4.17.21",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.10.0",
        "nodemon": "^3.1.7",
        "rimraf": "^6.0.1",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.10",
        "typescript": "^5.7.2"
    }
}
